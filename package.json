    "@platejs/table": "^53.0.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "^5.5.2",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.13.16",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.15",
