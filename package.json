{
  "name": "folio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "vite build && tsx server/index.ts --open",
    "serve": "tsx server/index.ts",
    "folio": "node scripts/launch.mjs",
    "stop": "node scripts/launch.mjs --stop",
    "shortcut": "node scripts/shortcut.mjs",
    "desktop:dev": "node scripts/desktop/prepare.mjs && tauri dev",
    "desktop:build": "node scripts/desktop/prepare.mjs && tauri build --target aarch64-apple-darwin",
    "typecheck": "tsc -b",
    "test:desktop": "node --test \"server/*.test.ts\" \"scripts/desktop/*.test.mjs\"",
    "lint": "oxlint"
  },
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@citation-js/plugin-ris": "^0.9.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@embedpdf/core": "^2.15.1",
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/models": "^2.15.1",
    "@embedpdf/pdfium": "^2.15.1",
    "@embedpdf/plugin-annotation": "^2.15.1",
    "@embedpdf/plugin-capture": "^2.15.1",
    "@embedpdf/plugin-document-manager": "^2.15.1",
    "@embedpdf/plugin-history": "^2.15.1",
    "@embedpdf/plugin-interaction-manager": "^2.15.1",
    "@embedpdf/plugin-render": "^2.15.1",
    "@embedpdf/plugin-scroll": "^2.15.1",
    "@embedpdf/plugin-selection": "^2.15.1",
    "@embedpdf/plugin-tiling": "^2.15.1",
    "@embedpdf/plugin-viewport": "^2.15.1",
    "@embedpdf/plugin-zoom": "^2.15.1",
    "@firecrawl/pdf-inspector": "^1.25.2",
    "@hono/node-server": "^2.1.6",
    "@lezer/highlight": "1.2.5",
    "@mozilla/readability": "^0.6.0",
    "@platejs/autoformat": "^53.0.0",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/dnd": "^53.3.8",
